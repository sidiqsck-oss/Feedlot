APP_NAME="SCK Feedlot"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.ptscki.co.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ──────────────────────────────────────────────
# Isi dari cPanel > MySQL Databases. Nama database & user di cPanel
# selalu diawali prefix akun, mis. "sckxxxxx_feedlot".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Driver ────────────────────────────────────────────────
# Semua pakai database, bukan file/redis. Shared hosting tanpa SSH
# nggak punya Redis, dan driver file gampang kena masalah izin tulis.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Token migrasi ─────────────────────────────────────────
# Tanpa SSH, migration dijalankan lewat route terproteksi.
# Isi dengan string acak panjang, dan kosongkan lagi setelah rilis stabil.
# Kalau kosong, route-nya mati total.
DEPLOY_TOKEN=

# ── Integrasi (diisi belakangan) ──────────────────────────
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

GOOGLE_SHEETS_KEY=
GOOGLE_SHEET_OVK_ID=
GOOGLE_SHEET_HOSPITAL_ID=

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ptscki.co.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
